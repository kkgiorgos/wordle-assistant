{
  "name": "Wordle Assistant",
  "short_name": "Wordle Assistant",
  "description": "Offline, private Wordle solver. Mark tiles, narrow the field, find the best next guess.",
  "id": "/wordle/v3/",
  "start_url": "/wordle/v3/?source=pwa",
  "scope": "/wordle/v3/",
  "display": "standalone",
  "display_override": ["standalone", "browser"],
  "orientation": "any",
  "background_color": "#1e1e2e",
  "theme_color": "#1e1e2e",
  "lang": "en",
  "categories": ["games", "utilities"],
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
